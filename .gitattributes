# Normalize all text files to LF in the repo, regardless of platform.
* text=auto eol=lf

# Windows-only scripts should still use CRLF when checked out on Windows.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files — never touch.
*.png binary
*.jpg binary
*.ogg binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary